# Copiar como terraform.tfvars y completar con los valores de tu cuenta del Learner Lab.
# Este archivo de ejemplo NO lleva secretos; terraform.tfvars no se versiona.

# VPC por defecto del lab y sus subredes públicas:
#   aws ec2 describe-vpcs --filters Name=isDefault,Values=true --query "Vpcs[0].VpcId" --output text
#   aws ec2 describe-subnets --filters Name=vpc-id,Values=<vpc> Name=map-public-ip-on-launch,Values=true --query "Subnets[].SubnetId"
vpc_id     = "vpc-xxxxxxxx"
subnet_ids = ["subnet-aaaaaaaa", "subnet-bbbbbbbb"]

# Tu IP pública con /32 (curl https://checkip.amazonaws.com): única que abre el dashboard de RabbitMQ
admin_cidr = "0.0.0.0/32"

# Frontend: tu fork del repo Tienda-native y un token de GitHub (classic, permiso "repo")
frontend_repository = "https://github.com/<tu-usuario>/Tienda-native"
github_access_token = "ghp_xxxxxxxxxxxxxxxxxxxx"

# Contraseñas TEMPORALES de los usuarios de prueba (Cognito pide cambiarlas en el primer login).
# Política: 8+ caracteres con mayúscula, minúscula, número y símbolo.
test_user_password   = "CambiaEsto123!"
lector_user_email    = "lector@tiendanative.com"
lector_user_password = "CambiaEsto456!"
